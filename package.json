{
  "name": "developer-card-graphql",
  "version": "1.0.0",
  "description": "Senior TypeScript Backend Digital Business Card — NestJS, Prisma, PostgreSQL, GraphQL (Apollo Sandbox), DataLoader N+1 Optimization & Docker",
  "author": "Konstantin (@markankamaransheogarat-sys)",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "npx prisma migrate deploy && node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test test/**/*.spec.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "graphql": "^16.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "prisma": "^5.20.0",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
